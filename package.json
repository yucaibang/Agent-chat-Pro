{
  "name": "agent-chat-pro",
  "version": "3.7.1",
  "description": "Agent Chat Pro — 三模式 AI 聊天客户端（SSH远程/云端AI/本机）",
  "author": "Jiang",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "obfuscate": "node scripts/obfuscate.cjs obfuscate",
    "obfuscate:restore": "node scripts/obfuscate.cjs restore",
    "obfuscate:check": "node scripts/obfuscate.cjs check",
    "build:win:nsis": "node scripts/build-pipeline.cjs nsis",
    "build:win:portable": "node scripts/build-pipeline.cjs portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "verify:fuses": "node scripts/set-fuses.cjs",
    "verify:build": "node scripts/build-pipeline.cjs verify"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "https-proxy-agent": "^9.1.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.6",
    "socks-proxy-agent": "^10.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "javascript-obfuscator": "^5.5.0"
  },
  "build": {
    "appId": "com.jiang.agentChatPro",
    "productName": "Agent Chat Pro",
    "copyright": "Copyright © 2026 Jiang",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "!src/bridge/node_modules"
    ],
    "extraResources": [
      {
        "from": "src/bridge",
        "to": "bridge",
        "filter": [
          "agent-sdk-bridge.mjs",
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "src/device-control",
        "to": "device-control"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Chat Pro",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": 2052,
      "unicode": true,
      "license": "build/license_zh.txt"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Network"
    }
  }
}
